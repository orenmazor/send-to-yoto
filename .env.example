# Required. Create a Public Client at https://dashboard.yoto.dev/ and set its
# Allowed Callback URLs to <PUBLIC_BASE_URL>/callback.
YOTO_CLIENT_ID=

# Optional
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080   # must match the dashboard callback URL
YOTO_SCOPES=offline_access user:content:manage
YOTO_TOKEN_FILE=/config/tokens.json    # persist tokens across restarts; unset = re-auth on restart
YOTO_DEFAULT_ICON=yoto:#aUm9i3ex3qqAMYBv-i-O-pYMKuMJGICtR3Vhf289u2Q
MAX_TRACKS=100                         # Yoto rejects playlists over 100 chapters
YOTO_AUTH_BASE=https://login.yotoplay.com
YOTO_API_BASE=https://api.yotoplay.com
